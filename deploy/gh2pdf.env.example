# gh2pdf server configuration. Copied to /etc/gh2pdf/gh2pdf.env by
# deploy.sh; fill in the values from your GitHub App settings.

# --- Required -------------------------------------------------------------

# App ID shown on the GitHub App's settings page.
GH2PDF_APP_ID=

# Private key (PEM) generated for the App. deploy.sh creates the /etc/gh2pdf
# directory; upload the key there and keep it readable only by the gh2pdf user.
GH2PDF_PRIVATE_KEY=/etc/gh2pdf/private-key.pem

# Webhook secret configured on the App.
GH2PDF_WEBHOOK_SECRET=

# --- Optional (defaults shown) -------------------------------------------

# Port the server listens on; must match the nginx proxy_pass port.
#GH2PDF_PORT=8080

# Login of the App's bot account: "<app-slug>[bot]". Events sent by this
# account are ignored to prevent description-edit loops.
#GH2PDF_BOT_LOGIN=gh2pdf[bot]

# PDF production parameters (see README for the full list).
#GH2PDF_RELEASE_TAG=gh2pdf
#GH2PDF_OMIT_USER=
#GH2PDF_TZ_OFFSET=3
#GH2PDF_PAPER=a4
#GH2PDF_FONT=Libertinus Serif
#GH2PDF_FONT_SIZE=11

#RUST_LOG=info
